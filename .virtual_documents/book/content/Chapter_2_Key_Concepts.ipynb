g_drones_bipartite = nx.Graph()

nodes_for_2019R0945 = [y for x, y in g_drones.edges() if (x == "2019R0945") & (y not in drone_specific)]
nodes_for_2019R0947 = [y for x, y in g_drones.edges() if (x == "2019R0947") & (y not in drone_specific)]
nodes_for_2021R0664 = [y for x, y in g_drones.edges() if (x == "2021R0664") & (y not in drone_specific)]
nodes_for_2021R0665 = [y for x, y in g_drones.edges() if (x == "2021R0665") & (y not in drone_specific)]

edges_for_2019R0945 = [(x,y) for x, y in g_drones.edges() if (x == "2019R0945") & (y not in drone_specific)]
edges_for_2019R0947 = [(x,y) for x, y in g_drones.edges() if (x == "2019R0947") & (y not in drone_specific)]
edges_for_2021R0664 = [(x,y) for x, y in g_drones.edges() if (x == "2021R0664") & (y not in drone_specific)]
edges_for_2021R0665 = [(x,y) for x, y in g_drones.edges() if (x == "2021R0665") & (y not in drone_specific)]

for i,j in zip(drone_specific, ["consumer", "contract", "tort", "environmental"]):
    g_drones_bipartite.add_node(i, bipartite=0, type=j)

for i in nodes_for_2019R0945:
    g_drones_bipartite.add_node(i, bipartite=1, type="consumer")

for i in nodes_for_2019R0947:
    g_drones_bipartite.add_node(i, bipartite=1, type="contract")

for i in nodes_for_2021R0664:
    g_drones_bipartite.add_node(i, bipartite=1, type="tort")

for i in nodes_for_2021R0665:
    g_drones_bipartite.add_node(i, bipartite=1, type="environmental")


for edgecollection in [edges_for_2019R0945, edges_for_2019R0947, edges_for_2021R0664, edges_for_2021R0665]:
    for i,j in edgecollection:
        g_drones_bipartite.add_edge(i,j)

